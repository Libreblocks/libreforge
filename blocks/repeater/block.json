{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "libreforge/repeater",
	"title": "Dynamic Repeater",
	"category": "libreforge",
	"icon": "controls-repeat",
	"description": "Repeats the blocks inside it for every row of a repeater field.",
	"keywords": [
		"repeater",
		"faq",
		"list"
	],
	"textdomain": "libreforge",
	"attributes": {
		"source": {
			"type": "string",
			"default": "meta"
		},
		"key": {
			"type": "string",
			"default": ""
		},
		"tag": {
			"type": "string",
			"default": "div"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"text": true,
			"background": true,
			"link": true
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"editorScript": "libreforge-blocks",
	"editorStyle": "libreforge-blocks"
}
