# Fase 1c: relações
msgid "A box appears on the edit screen to pick the related items."
msgstr "Uma caixa aparece na tela de edição para escolher os itens relacionados."

msgid "Box on the child"
msgstr "Caixa no filho"

msgid "Box on the parent"
msgstr "Caixa no pai"

msgid "Broker"
msgstr "Corretor"

