msgstr "Crie sua primeira relação"

msgid "Each item of %1$s can have many items of %2$s; each item of %2$s belongs to one %1$s."
msgstr "Cada item de %1$s pode ter vários itens de %2$s; cada item de %2$s pertence a um item de %1$s."

msgid "Each item of %1$s is linked to one item of %2$s, and vice versa."
msgstr "Cada item de %1$s se liga a um item de %2$s, e vice-versa."

msgid "Ex.: Broker → Properties, Course → Lessons."
msgstr "Ex.: Corretor → Imóveis, Curso → Aulas."

msgid "Ex.: on a broker page, list only their properties."
msgstr "Ex.: na página de um corretor, listar só os imóveis dele."

msgid "Ex.: on each broker, pick their properties."
msgstr "Ex.: em cada corretor, escolher os imóveis dele."

msgid "Ex.: on each property, pick its broker."
msgstr "Ex.: em cada imóvel, escolher o corretor."

msgid "How many on each side"
msgstr "Quantos de cada lado"

