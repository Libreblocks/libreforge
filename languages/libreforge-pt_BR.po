msgstr "Itens de %1$s podem ter vários itens de %2$s, e cada um deles pode pertencer a vários itens de %1$s."

msgid "Its children (e.g. the properties of this broker)"
msgstr "Os filhos dele (ex.: os imóveis deste corretor)"

msgid "Its parents (e.g. the broker of this property)"
msgstr "Os pais dele (ex.: o corretor deste imóvel)"

